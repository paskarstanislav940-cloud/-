# ================================================================
#  Настройки парсера fioritura. Впиши значения после знака «=».
#  Пробелы вокруг «=» не нужны. Кавычки не нужны.
# ================================================================

# 1) Ключи Telegram-аккаунта: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# 2) Токен бота от @BotFather (/newbot)
BOT_TOKEN=

# 3) Куда бот шлёт найденные заказы. Узнать: напиши боту /start,
#    потом в START.bat нажми 7 — там будет готовая строка.
TARGET_CHAT_ID=

# 4) Какие Telegram-чаты слушать — через запятую.
#    Список своих чатов с id: START.bat -> 8.
#    Пример: TG_CHATS=@freelance_chat, @another_chat, -1001234567890
TG_CHATS=

# 5) Ссылка на твоё портфолио — попадёт в черновики ответов
PORTFOLIO_URL=https://fioritura.example.com

# 6) Reddit просит указать контакт. Впиши свой ник на Reddit вместо your_reddit_name
REDDIT_USER_AGENT=fioritura-leads/1.0 (lead monitor; contact via u/your_reddit_name)
