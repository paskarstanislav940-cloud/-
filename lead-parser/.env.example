# Скопируйте в .env и заполните. Файл .env не коммитится (см. .gitignore).

# https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# @BotFather → /newbot
BOT_TOKEN=123456789:AA...
# узнать: напишите боту /start, затем python main.py --bot-chats
TARGET_CHAT_ID=123456789

# Ссылка в черновиках ответов
PORTFOLIO_URL=https://fioritura.example.com

# Reddit просит внятный User-Agent с контактом
REDDIT_USER_AGENT=fioritura-leads/1.0 (lead monitor; contact via u/your_reddit_name)
